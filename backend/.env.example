# Server-only settings. Never put actual credentials in Git or room messages.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
VERA_DB_SCHEMA=vera
# Optional: sqlite for offline local demo/tests; cloud uses postgres.
VERA_DB_BACKEND=postgres
VERA_AUTO_INIT=0
# Product images use a private Cloudflare R2 bucket. Do not commit real keys.
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_BUCKET=vera-crm
R2_ACCESS_ID=replace-with-r2-access-key-id
R2_ACCESS_KEY=replace-with-r2-secret-access-key
VERA_STORAGE_BACKEND=r2

# Optional SMTP email delivery. Configure real values only in server environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# AI drafting and automatic communication analysis (server only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Read incoming email without marking messages read.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Random secret of at least 24 characters for scheduled sync / inbound webhook.
CRON_SECRET=
