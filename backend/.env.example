# Server-only settings. Never put actual credentials in Git or room messages.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
VERA_DB_SCHEMA=vera
# Optional: sqlite for offline local demo/tests; cloud uses postgres.
VERA_DB_BACKEND=postgres
VERA_AUTO_INIT=0
# Product images use a private Cloudflare R2 bucket. Do not commit real keys.
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_BUCKET=vera-crm
R2_ACCESS_ID=replace-with-r2-access-key-id
R2_ACCESS_KEY=replace-with-r2-secret-access-key
VERA_STORAGE_BACKEND=r2

# Demo is the safe default. In demo, SMTP_FROM must equal the private test address;
# both From and To are forced to that address regardless of the customer record.
VERA_EMAIL_MODE=demo
VERA_DEMO_EMAIL_ADDRESS=
# Live customer delivery requires an explicit second server-side approval flag.
VERA_LIVE_EMAIL_APPROVED=no
# Optional SMTP email delivery. Configure values only in the private server environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
